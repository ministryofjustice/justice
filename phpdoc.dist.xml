<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
        configVersion="3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://www.phpdoc.org"
>
    <title>Justice theme</title>
    <paths>
        <output>.github/pages/_site/phpdoc</output>
    </paths>
    <version number="3.0.0">
        <api>
            <source dsn=".">
                <path>.</path>
            </source>
            <ignore hidden="true" symlinks="true">
                <path>node_modules/**/*</path>
                <path>dist/**/*</path>
                <path>vendor/**/*</path>
                <path>**/*.stories.php</path>
                <path>.github/**/*</path>
            </ignore>
        </api>
    </version>
</phpdocumentor>
